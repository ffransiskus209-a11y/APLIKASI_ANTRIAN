# Salin file ini menjadi .env, lalu sesuaikan nilainya.
# cp .env.example .env
# File .env TIDAK BOLEH di-commit (lihat .gitignore).

# --- Aplikasi ---
NODE_ENV=development
PORT=3000

# Port di sisi HOST
WEB_PORT=5173
SERVER_PORT=3001
DB_HOST_PORT=3307

# --- Database ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=queueapp
DB_USER=queueapp
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- Security ---
JWT_SECRET=change-me